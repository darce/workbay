{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Single-use, commit-bound merge capability. ``open_findings`` is structurally 0.",
  "properties": {
    "candidate_sha": {
      "maxLength": 40,
      "minLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "title": "Candidate Sha",
      "type": "string"
    },
    "close_check_id": {
      "minLength": 1,
      "title": "Close Check Id",
      "type": "string"
    },
    "consumed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "not": {
            "pattern": "[\\r\\n]"
          },
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumed At"
    },
    "open_findings": {
      "const": 0,
      "default": 0,
      "title": "Open Findings",
      "type": "integer"
    },
    "review_run_id": {
      "minLength": 1,
      "title": "Review Run Id",
      "type": "string"
    },
    "task_ref": {
      "description": "Short task identifier, e.g. 'internal' or 'internal'.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Ref",
      "type": "string"
    },
    "verified_test_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Verified Test Ids",
      "type": "array"
    }
  },
  "required": [
    "task_ref",
    "candidate_sha",
    "review_run_id",
    "close_check_id"
  ],
  "title": "MergeCapability",
  "type": "object"
}
