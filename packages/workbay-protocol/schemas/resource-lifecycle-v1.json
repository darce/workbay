{
  "$defs": {
    "Allow": {
      "additionalProperties": false,
      "properties": {
        "effects_authorized": {
          "const": false,
          "default": false,
          "title": "Effects Authorized",
          "type": "boolean"
        },
        "kind": {
          "const": "allow",
          "default": "allow",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "execution",
            "retention"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "Allow",
      "type": "object"
    },
    "ApplyRequest": {
      "additionalProperties": false,
      "description": "R4/R5 must hold a per-resource lock across re-probe and any effects.",
      "properties": {
        "dry_run": {
          "default": true,
          "title": "Dry Run",
          "type": "boolean"
        },
        "expected_plan_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Plan Digest",
          "type": "string"
        },
        "kind": {
          "const": "apply",
          "default": "apply",
          "title": "Kind",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/RetentionPlan"
        },
        "probe": {
          "$ref": "#/$defs/RetentionProbe"
        }
      },
      "required": [
        "plan",
        "expected_plan_digest",
        "probe"
      ],
      "title": "ApplyRequest",
      "type": "object"
    },
    "ByteAccounting": {
      "additionalProperties": false,
      "properties": {
        "estimated_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Bytes"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "measured_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Bytes"
        }
      },
      "title": "ByteAccounting",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "description": "IDs stay in their authority's namespace. Presence alone proves no join.",
      "properties": {
        "orca": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrcaIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified_join": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workbay": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkBayIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Correlation",
      "type": "object"
    },
    "CustodyAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "acknowledgement": {
          "$ref": "#/$defs/Proof"
        },
        "archive": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "fidelity": {
          "$ref": "#/$defs/Proof"
        },
        "resource": {
          "$ref": "#/$defs/ResourceIdentity"
        },
        "restored_fsck": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "items": {
            "enum": [
              "full_bytes",
              "types",
              "links",
              "refs",
              "reflogs",
              "ignored"
            ],
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "docker": "#/$defs/DockerSource",
              "git": "#/$defs/GitSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "$ref": "#/$defs/DockerSource"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "resource",
        "source",
        "scope",
        "archive",
        "acknowledgement",
        "fidelity"
      ],
      "title": "CustodyAcknowledgement",
      "type": "object"
    },
    "DependencyEdge": {
      "additionalProperties": false,
      "description": "Consumer -> required provider. R1 supplies reachability/SCC verdicts.",
      "properties": {
        "consumer": {
          "$ref": "#/$defs/ResourceIdentity"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        },
        "provider": {
          "$ref": "#/$defs/ResourceIdentity"
        },
        "relation": {
          "enum": [
            "git",
            "symlink",
            "editable",
            "process",
            "mount",
            "container",
            "child_image",
            "rollback",
            "db_volume",
            "other"
          ],
          "title": "Relation",
          "type": "string"
        },
        "state": {
          "enum": [
            "required",
            "released",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "provider",
        "relation",
        "state",
        "proof"
      ],
      "title": "DependencyEdge",
      "type": "object"
    },
    "DependencySnapshot": {
      "additionalProperties": false,
      "description": "No guessed order: retained consumers hold providers and whole SCCs.\n\nR1 must inventory incoming/reachable consumers and condense cycles before\nasserting no_live_consumers and scc_clear. This is a verdict interface, not\na graph algorithm. Unknown privileged inventory must remain unknown.",
      "properties": {
        "component_members": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceIdentity"
          },
          "title": "Component Members",
          "type": "array"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "inventory_complete": {
          "$ref": "#/$defs/Proof"
        },
        "no_live_consumers": {
          "$ref": "#/$defs/Proof"
        },
        "scc_clear": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "inventory_complete",
        "no_live_consumers",
        "scc_clear"
      ],
      "title": "DependencySnapshot",
      "type": "object"
    },
    "DockerFacts": {
      "additionalProperties": false,
      "description": "R2 asserts absence with separate proofs, including stopped containers.\n\nDB/recovery volume clearance additionally requires explicit permission;\ndangling images, age and a failed privileged read grant no clearance.",
      "properties": {
        "db_volume_permission": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "db_volume_released": {
          "$ref": "#/$defs/Proof"
        },
        "inventory_complete": {
          "$ref": "#/$defs/Proof"
        },
        "no_child_images": {
          "$ref": "#/$defs/Proof"
        },
        "no_running_containers": {
          "$ref": "#/$defs/Proof"
        },
        "no_stopped_containers": {
          "$ref": "#/$defs/Proof"
        },
        "rollback_released": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "inventory_complete",
        "no_running_containers",
        "no_stopped_containers",
        "no_child_images",
        "rollback_released",
        "db_volume_released"
      ],
      "title": "DockerFacts",
      "type": "object"
    },
    "DockerSource": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "const": "docker",
          "default": "docker",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "title": "DockerSource",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Immutable private evidence reference; never embed credentials or payloads.",
      "properties": {
        "digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionObservation": {
      "additionalProperties": false,
      "description": "Observed values, never copied from request/config as served-model proof.\n\nAccount/profile fields contain opaque nonsecret references only. Catalogue\nsupport and observed served execution are separate positive observations.\nMissing public handoff rows, wrong imported runtime or inaccessible users\nremain real unknown/denied observations, not fabricated running states.",
      "properties": {
        "account_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^opaque:[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Ref"
        },
        "agent_binary": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Binary"
        },
        "authenticated": {
          "$ref": "#/$defs/Proof"
        },
        "backend": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "binary_executable": {
          "$ref": "#/$defs/Proof"
        },
        "catalogue_verified": {
          "$ref": "#/$defs/Proof"
        },
        "cost_allowed": {
          "$ref": "#/$defs/Proof"
        },
        "effort": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "execution_user": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution User"
        },
        "handoff_available": {
          "$ref": "#/$defs/Proof"
        },
        "identity_verified": {
          "$ref": "#/$defs/Proof"
        },
        "kind": {
          "const": "execution_observation",
          "default": "execution_observation",
          "title": "Kind",
          "type": "string"
        },
        "profile_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^opaque:[A-Za-z0-9._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Ref"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "remote_available": {
          "$ref": "#/$defs/Proof"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_verified": {
          "$ref": "#/$defs/Proof"
        },
        "served_execution_verified": {
          "$ref": "#/$defs/Proof"
        },
        "served_model": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Served Model"
        },
        "service_tier": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_verified": {
          "$ref": "#/$defs/Proof"
        },
        "supported_models": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "not": {
                  "pattern": "[\\u0000-\\u001f]"
                },
                "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supported Models"
        },
        "workspace": {
          "anyOf": [
            {
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001f]"
              },
              "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace"
        },
        "workspace_accessible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Accessible"
        },
        "workspace_verified": {
          "$ref": "#/$defs/Proof"
        }
      },
      "title": "ExecutionObservation",
      "type": "object"
    },
    "ExecutionRequest": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^opaque:[A-Za-z0-9._/-]+$",
          "title": "Account Ref",
          "type": "string"
        },
        "agent_binary": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Agent Binary",
          "type": "string"
        },
        "backend": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Backend",
          "type": "string"
        },
        "correlation": {
          "$ref": "#/$defs/Correlation"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "title": "Effort",
          "type": "string"
        },
        "execution_user": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Execution User",
          "type": "string"
        },
        "kind": {
          "const": "execution_request",
          "default": "execution_request",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Model",
          "type": "string"
        },
        "profile_ref": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^opaque:[A-Za-z0-9._/-]+$",
          "title": "Profile Ref",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Provider",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceIdentity"
        },
        "service_tier": {
          "enum": [
            "standard",
            "priority",
            "flex"
          ],
          "title": "Service Tier",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/GitSource"
        },
        "workspace": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "source",
        "execution_user",
        "agent_binary",
        "workspace",
        "backend",
        "provider",
        "account_ref",
        "profile_ref",
        "model",
        "effort",
        "service_tier"
      ],
      "title": "ExecutionRequest",
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "git",
          "default": "git",
          "title": "Kind",
          "type": "string"
        },
        "revision": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "tree": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "tree"
      ],
      "title": "GitSource",
      "type": "object"
    },
    "Held": {
      "additionalProperties": false,
      "properties": {
        "effects_authorized": {
          "const": false,
          "default": false,
          "title": "Effects Authorized",
          "type": "boolean"
        },
        "holds": {
          "items": {
            "$ref": "#/$defs/Hold"
          },
          "minItems": 1,
          "title": "Holds",
          "type": "array"
        },
        "kind": {
          "const": "held",
          "default": "held",
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "enum": [
            "execution",
            "retention"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "holds"
      ],
      "title": "Held",
      "type": "object"
    },
    "Hold": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "proof_unknown",
            "proof_denied",
            "proof_contradictory",
            "proof_missing_evidence",
            "proof_missing_freshness",
            "proof_stale",
            "proof_future",
            "proof_invalid_window",
            "execution_user_unknown",
            "execution_user_mismatch",
            "agent_binary_unknown",
            "agent_binary_mismatch",
            "agent_binary_not_absolute",
            "workspace_unknown",
            "workspace_mismatch",
            "workspace_not_absolute",
            "workspace_access_unknown",
            "workspace_inaccessible",
            "source_unknown",
            "source_mismatch",
            "resource_unknown",
            "resource_mismatch",
            "foreign_owner",
            "backend_unknown",
            "backend_mismatch",
            "provider_unknown",
            "provider_mismatch",
            "account_ref_unknown",
            "account_ref_mismatch",
            "profile_ref_unknown",
            "profile_ref_mismatch",
            "served_model_unknown",
            "served_model_mismatch",
            "effort_unknown",
            "effort_mismatch",
            "service_tier_unknown",
            "service_tier_mismatch",
            "model_catalogue_unknown",
            "model_unsupported",
            "plan_changed",
            "registration_changed",
            "dependencies_changed",
            "custody_changed",
            "custody_scope_missing",
            "custody_source_mismatch",
            "custody_resource_mismatch",
            "custody_fsck_missing",
            "dependency_required",
            "dependency_unknown",
            "scc_held",
            "docker_facts_missing",
            "db_volume_permission_missing",
            "stream_expectation_missing"
          ],
          "title": "Code",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001f]"
          },
          "pattern": "^[^\\u0000-\\u001f]*[^\\s\\u0000-\\u001f][^\\u0000-\\u001f]*$",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
